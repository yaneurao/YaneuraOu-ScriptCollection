#context correction_value

    return 12153@1 * pcv + 8620@2 * micv + 12355@3 * (wnpcv + bnpcv) + 7982@4 * cntcv + 6307@6ply * cntcv6;

#context update_correction_history_nonPawnWeight // update_correction_history()

