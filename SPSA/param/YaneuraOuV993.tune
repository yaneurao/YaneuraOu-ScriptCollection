#context Search_Decrease_reduction_for_PvNodes_6a

        if ((ss + 1)->cutoffCnt > 1)
            r += 251@ + 1124@ * ((ss + 1)->cutoffCnt > 2) + 1042@ * allNode;


#context Search_Decrease_reduction_for_PvNodes_7

        if (move == ttData.move)
