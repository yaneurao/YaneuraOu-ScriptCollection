#context Search_standPat // qsearch() Step 4.

		futilityBase = ss->staticEval + 328@;

#context YaneuraOuWorker_reduction

int Search::YaneuraOuWorker::reduction(bool i, Depth d, int mn) const {
    int reductionScale = reductions[d] * reductions[mn];
    return reductionScale + !i * reductionScale * 206@2 / 512 + 1133@3;

#context update_all_stats_1c // update_all_stats()

    int bonus =
      std::min(128@ * depth - 77@, 1529@) + 353@ * (bestMove == ttMove) + (ss - 1)->statScore / 32;
    int malus = std::min(882@ * depth - 204@, 2122@);


#context conthist_bonuses

    const std::array<ConthistBonus, 5> conthist_bonuses = {
      {{1, 520@ply1}, {2, 390@ply2}, {3, 145@ply3}, {4, 251@ply4}, {6, 209@ply6}}};

#context update_quiet_histories_1a // update_quiet_histories()

    if (ss->ply < LOW_PLY_HISTORY_SIZE)
        workerThread.lowPlyHistory[ss->ply][move.raw()] << bonus * 761@ / 1024;

    update_continuation_histories(ss, pos.moved_piece(move), move.to_sq(), bonus * 955@ / 1024);

#context update_quiet_histories_2b

    workerThread.sharedHistory.pawn_entry(pos)[pos.moved_piece(move)][move.to_sq()]
      << bonus * (bonus > -4@threshold ? 850@1 : 550@2) / 1024;

#context YaneuraOuWorker_clear1

    captureHistory.fill(-678@);

    // Each thread is responsible for clearing their part of shared history
    sharedHistory.correctionHistory.clear_range(0, numaThreadIdx, numaTotal);
    sharedHistory.pawnHistory.clear_range(-1238@, numaThreadIdx, numaTotal);

	ttMoveHistory = 0;

    for (auto& to : continuationCorrectionHistory)
        for (auto& h : to)
            h.fill(6@);

#context Search_nullmove_2

        Depth R = 7@1 + depth / 3 + std::max((ss->staticEval - beta) / 256@margin, 0) - int(threadIdx & 1);

#context Search_nullmove_3

            if (nmpMinPly || depth < 16@)
            {
                ++ss->priorNMPFailHigh;
                return nullValue;
            }

#context Search_nullmove_4 // Search step 9.

            nmpMinPly = ss->ply + 3@ * (depth - R) / 4;

#context Search_IIR

    if (!ss->followPV && !allNode && depth >= 6@1 && !ttData.move)
        depth--;

#context Search_Capture_SEE_pruning_margin // Search step 14.

                int margin = std::max(167@ * depth + captHist * 34@ / 1024, 0);

#context Search_All_node_reduction_scale // search() Step 16.

        // Scale up reductions for expected ALL nodes
        if (allNode)
            r += r * 273@ / (256 * depth + 260);

#context Search_LMR_research_thresholds // search() Step 17.

                const bool doDeeperSearch    = d < newDepth && value > bestValue + 48@;
                const bool doShallowerSearch = value < bestValue + 9@;

#context Search_fail_low_quiet_bonus // search() Step 21.

        int bonusScale = -232@;
        bonusScale -= (ss - 1)->statScore / 108@;
        bonusScale += std::min(59@ * depth, 454@);
        bonusScale += 169@ * ((ss - 1)->moveCount > 8@);
        bonusScale += 145@ * (!ss->inCheck && bestValue <= ss->staticEval - 110@);
        bonusScale += 154@ * (!(ss - 1)->inCheck && bestValue <= -(ss - 1)->staticEval - 73@);

        bonusScale = std::max(bonusScale, 0);

        const int scaledBonus = std::min(135@ * depth - 80@, 1400@) * bonusScale;

        update_continuation_histories(ss - 1, pos.piece_on(prevSq), prevSq,
                                      scaledBonus * 221@ / 16384);

        mainHistory[~us][((ss - 1)->currentMove).raw()] << scaledBonus * 235@ / 32768;

		// TODO : これで合ってるか？あとで検証する。
        if (type_of(pos.piece_on(prevSq)) != PAWN && ((ss - 1)->currentMove).type_of() != PROMOTION)
            sharedHistory.pawn_entry(pos)[pos.piece_on(prevSq)][prevSq] << scaledBonus * 290@ / 8192;

#context Search_fail_low_capture_bonus // search() Step 21.

        captureHistory[pos.piece_on(prevSq)][prevSq][type_of(capturedPiece)] << 1018@;

#context Search_correction_history_bonus // search() Step 21.

        auto bonus =
          std::clamp(int(bestValue - ss->staticEval) * depth * (bestMove ? 12@ : 17@) / 128,
                     -CORRECTION_HISTORY_LIMIT / 4, CORRECTION_HISTORY_LIMIT / 4);

        update_correction_history(pos, ss, *this, 1069@ * bonus / 1024);

#context QSearch_move_count_pruning // qsearch() Step 6.

				if (moveCount > 2@)
                    continue;

#context QSearch_SEE_pruning // qsearch() Step 6.

            if (!pos.see_ge(move, -73@))
                continue;


#context Search_futility_blend

            const int betaWeight = 661@;
            return (betaWeight * beta + (1024 - betaWeight) * eval) / 1024;

#context Search_PV_reduction

        if (PvNode)
            r -= 512@;

#context Search_lmr_divisor

inline int lmr_divisor(int depth) {
    int d = std::min(depth, 16);
    return 3000@base + 7@slope * (d - 8) * (d - 8);
}

#context Search_LMR_eval_margin

        if (!capture && !is_decisive(alpha))
            r += 3@scale * std::clamp(alpha - eval, -64@min, 96@max);

#context Search_ttMoveHistoryPenalty

                ttMoveHistory << -424@1 - 107@2 * depth;

#context Search_multicut_correction

                    const int bonus =
                      std::clamp(int(value - ss->staticEval) * 664@ / 1024,
                                 -CORRECTION_HISTORY_LIMIT / 4, CORRECTION_HISTORY_LIMIT / 4);

#context Search_negative_extension

            else if (ttData.value >= beta || cutNode)
                extension = -3@;

#context CMHC_multipliers

    const int CMHCMultipliers[] = {94@0, 103@1, 110@2, 106@3, 119@4, 126@5};

#context CMHC_bonus

            historyEntry << int(i64(bonus) * weight * multiplier / 65536) + 73@ * (i < 2);

#context Search_fail_high_recovery_decay

            if (!pvIdx)
                failHighRecovery = std::max(0, failHighRecovery - 2@);

#context Search_fail_high_recovery

            if (failedHighCnt > 0 && !pvIdx)
                failHighRecovery = (failedHighCnt + 1) / 2 + 2@;

#context main_history_decay

            mainHistory[c][i] = mainHistory[c][i] * 729@ / 1024;

#context main_history_initial

constexpr int mainHistoryDefault    = 0@;

#add

int& mainHistoryDefault = @;

#context history_nonPV_bonus

    if (!PvNode)
        bonus += int(i64(bonus) * int(quietsSearched.size() + capturesSearched.size()) / 256@);

#context root_score_EMA_ratio

            const u64     ChiNumerator   = 3@numerator;
            const u64     ChiDenominator = 2@denominator;   // Chi = 3/2 = 1.5

#context Search_razoring_linear

    if (allNode && eval < alpha - 342@ * depth && !seekMate)
        return qsearch<NonPV>(pos, ss, alpha, beta);


