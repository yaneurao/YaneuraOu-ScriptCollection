#context Search_Probcut // Search step 11.

    probCutBeta = beta + 224@ - 61@ * improving;

#context Search_small_Probcut // search() Step 12.

    probCutBeta = beta + 416@;

#context Search_decrease_reduction_for_tt_pv // search() Step 13.

        if (ss->ttPv)
