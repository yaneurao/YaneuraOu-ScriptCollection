        r += 691@;  // Base reduction offset to compensate for other tweaks

#context Search_Decrease_reduction_for_PvNodes_3

		r -= moveCount * 65@;
        r -= std::abs(correctionValue) / 25600@;

#context Search_Decrease_reduction_for_PvNodes_4

        if (cutNode)
