{
    // 対局開始を行う互角局面集のファイルPATH。
    "START_SFENS_PATH": "settings/startpos-sfens.txt",

    // 対局の最大手数
    "MAX_GAME_PLY" : 320,

    // 棋譜を生成するときの探索ノード数
    "NODES" : 1000000,

    // hcpe3の生成を行うとき。
    // MultiPV 4でNODES分探索して、その結果からMoveVisitsを作る場合:
    // "OUTPUT_FORMAT": "hcpe3",
    // "MULTIPV": 4,
    // "HCPE3_TEMPERATURE": 100.0,

    // 追加policy探索を使う場合:
    // HCPE3_POLICY_NODES > 0 のとき、policy候補手は以下の追加探索で集め、
    // 実着手とevalは NODES の MultiPV=1 探索で確定する。
    // "HCPE3_POLICY_NODES": 500000,
    // "HCPE3_POLICY_MULTIPV": 30,

    "ENGINE_SETTING":
    [
        {
            "path":"C:/shogi/engine/YaneuraOu.exe",
            "name":"YaneuraOu",
            "multi":1
        },
        /* // SSHでの起動例
        {
            "path":"ssh -o ServerAliveInterval=15 worker01 YaneuraOu.bat",
            "name":"remote-YaneuraOu",
            "multi":32 // ssh越しに32個起動する
        }
        */
    ],

}
